APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8005
API_CPUS=1.0
API_MEMORY_LIMIT=2g
API_MAX_PENDING_REQUESTS=2
MONGO_CPUS=0.5
MONGO_MEMORY_LIMIT=512m
MONGO_HOST_PORT=27018
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=analyse_toxicite
COLLECTION_WINDOW_DAYS=14
MAX_ARTICLES_PER_SITE=30
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
REQUEST_DELAY_SECONDS=2
MAX_CONCURRENT_REQUESTS=4
MODEL_ID=unitary/multilingual-toxic-xlm-roberta
MODEL_REVISION=4ad6f5c104d9ce813a1a2f33cac0c5b579ef6ee5
MODEL_DEVICE=cpu
MODEL_DTYPE=float16
MODEL_CACHE_DIR=cache/modeles
# Un chemin hôte absolu peut remplacer le volume nommé pour un cache sur un autre disque.
MODEL_CACHE_VOLUME=cache_modeles
INFERENCE_BATCH_SIZE=1
INFERENCE_CONCURRENCY=1
TORCH_THREADS=1
TOXICITY_THRESHOLD=0.50
HIGH_SCORE_THRESHOLD=0.80
MAX_TEXT_CHARACTERS=20000
SOURCES_FILE=configuration/sources.yaml
